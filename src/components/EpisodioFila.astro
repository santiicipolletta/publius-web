---
import type { Episodio } from '../lib/podcast';
import { duracionLegible } from '../lib/podcast';
import { fechaLarga, fechaISO } from '../lib/fechas';

interface Props {
  episodio: Episodio;
  /* En Fuera de Contexto la descripción vale la pena verla siempre;
     en un informativo diario de 194 episodios, sólo al abrir. */
  abierto?: boolean;
}

const { episodio, abierto = false } = Astro.props;
const fecha = new Date(episodio.fecha);
const duracion = duracionLegible(episodio.duracion);
---

{/* <details> para que el reproductor cargue sólo al abrir el episodio:
    194 elementos <audio> en una página serían 194 pedidos al servidor.
    preload="none" hace lo mismo para el audio en sí. */}
<details class="group border-b border-borde last:border-0" open={abierto}>
  <summary
    class="flex cursor-pointer list-none items-baseline gap-3 py-3.5 marker:content-none hover:bg-fondo">
    <svg
      viewBox="0 0 12 8"
      class="mt-1.5 size-2.5 shrink-0 text-tinta-3 transition-transform duration-150 group-open:rotate-180"
      aria-hidden="true">
      <path
        d="M1 1.5 6 6.5 11 1.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>

    <span class="min-w-0 flex-1">
      <span class="block text-[0.9375rem] leading-snug font-semibold text-tinta">
        {episodio.titulo}
      </span>
      <span class="meta-linea mt-0.5 block">
        <time datetime={fechaISO(fecha)}>{fechaLarga(fecha)}</time>
        {
          duracion && (
            <>
              <span aria-hidden="true"> · </span>
              {duracion}
            </>
          )
        }
      </span>
    </span>
  </summary>

  <div class="pb-5 pl-[1.375rem]">
    {
      episodio.descripcion && (
        <p class="mb-4 max-w-[68ch] text-[0.875rem] leading-[1.65] whitespace-pre-line text-tinta-2">
          {episodio.descripcion}
        </p>
      )
    }

    {
      episodio.audio && (
        <audio
          controls
          preload="none"
          src={episodio.audio}
          class="w-full max-w-lg"
          aria-label={`Escuchar: ${episodio.tituloCompleto}`}
        />
      )
    }

    {
      episodio.enlace && (
        <p class="mt-3">
          <a
            href={episodio.enlace}
            rel="noopener noreferrer"
            target="_blank"
            class="text-[0.8125rem] font-semibold text-sp no-underline hover:underline hover:underline-offset-[3px]">
            Abrir en Spotify &rarr;
          </a>
        </p>
      )
    }
  </div>
</details>

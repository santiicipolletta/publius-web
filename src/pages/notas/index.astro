---
import Base from '../../layouts/Base.astro';
import NotaCard from '../../components/NotaCard.astro';
import { notasPublicadas } from '../../lib/notas';

const notas = await notasPublicadas();
---

<Base titulo="Todas las notas" descripcion="El archivo completo de notas publicadas en Publius Group.">
  <section class="contenedor pt-10 pb-14">
    <div class="barra-seccion">
      <h1 class="rotulo">Todas las notas</h1>
      <p class="meta-linea">
        {notas.length}
        {notas.length === 1 ? 'nota publicada' : 'notas publicadas'}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-3 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {notas.map((nota) => <NotaCard nota={nota} />)}
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { ENLACES } from '../lib/enlaces';
import NotaCard from '../components/NotaCard.astro';
import CtaMultimedia from '../components/CtaMultimedia.astro';
import { getEntry } from 'astro:content';
import { notasPublicadas, imagenDe, altDe } from '../lib/notas';
import { fechaLarga, fechaISO } from '../lib/fechas';
import { cicloPorSlug } from '../lib/podcast';

/* Los números salen del feed, no escritos a mano: si publican un
   episodio nuevo, el home se actualiza al recompilar. */
const primeraParada = cicloPorSlug('primera-parada');
const fueraDeContexto = cicloPorSlug('fuera-de-contexto');

const todas = await notasPublicadas();

/* La nota destacada es la marcada como tal; si no hay ninguna,
   se usa la más reciente. */
const destacada = todas.find((n) => n.data.destacada) ?? todas[0];
const autorDestacada = destacada ? await getEntry(destacada.data.autor) : undefined;

const resto = todas.filter((n) => n.id !== destacada?.id);
/* La columna lateral toma tres; la grilla, hasta ocho (dos filas de cuatro) */
const enColumna = resto.slice(0, 3);
const enGrilla = resto.slice(3, 11);

const columnaConAutor = await Promise.all(
  enColumna.map(async (n) => ({ nota: n, autor: await getEntry(n.data.autor) })),
);
---

<Base
  titulo="Publius Group"
  descripcion="Publius Group — análisis de jóvenes sobre política, filosofía, economía, derecho e historia."
  portada>
  {/* Inmediatamente debajo del logotipo arranca el contenido:
      no hay banda intermedia ni texto de relleno. */}

  {
    destacada && (
      <section class="contenedor pt-8 pb-4" aria-labelledby="titulo-destacada">
        <div class="grid gap-x-10 gap-y-8 lg:grid-cols-[minmax(0,69fr)_minmax(0,31fr)]">
          {/* ---------- Nota destacada ---------- */}
          <article class="min-w-0">
            <a href={`/notas/${destacada.id}`} class="group block no-underline">
              <img
                src={imagenDe(destacada)}
                alt={altDe(destacada)}
                width="1200"
                height="800"
                fetchpriority="high"
                decoding="async"
                class="mb-6 aspect-16/9 w-full border border-borde object-cover"
              />

              <p class="rotulo mb-3">{destacada.data.categorias.join(' · ')}</p>

              <h1
                id="titulo-destacada"
                class="mb-4 max-w-[26ch] text-[clamp(1.9rem,3.6vw,2.85rem)] font-bold text-tinta group-hover:underline group-hover:decoration-navy group-hover:underline-offset-[5px]">
                {destacada.data.titulo}
              </h1>

              <p class="mb-5 max-w-[58ch] text-[1.0625rem] leading-[1.65] text-tinta-2">
                {destacada.data.extracto}
              </p>
            </a>

            <div class="flex flex-wrap items-center justify-between gap-4 border-t border-borde pt-4">
              <p class="meta-linea">
                <a
                  href={`/autores/${destacada.data.autor.id}`}
                  class="text-tinta no-underline hover:underline hover:underline-offset-[3px]">
                  {autorDestacada?.data.nombre}
                </a>
                <span aria-hidden="true"> · </span>
                <time datetime={fechaISO(destacada.data.fecha)}>
                  {fechaLarga(destacada.data.fecha)}
                </time>
              </p>

              <a
                href={`/notas/${destacada.id}`}
                class="group text-[0.8125rem] font-semibold text-navy no-underline">
                Leer la nota
                <span
                  class="inline-block transition-transform duration-150 group-hover:translate-x-1"
                  aria-hidden="true">
                  &nbsp;&rarr;
                </span>
              </a>
            </div>
          </article>

          {/* ---------- Columna lateral ---------- */}
          <aside class="flex min-w-0 flex-col gap-8">
            {/* Audio y video: acá viven el rojo y el verde */}
            <div>
              <h2 class="rotulo mb-3 border-b border-borde-fuerte pb-2.5">
                Publius en audio y video
              </h2>
              <div class="flex flex-col gap-2">
                <CtaMultimedia
                  plataforma="spotify"
                  href={ENLACES.spotify}
                  detalle={`Primera Parada · ${primeraParada?.episodios ?? 0} episodios`}
                />
                <CtaMultimedia
                  plataforma="youtube"
                  href={ENLACES.youtube}
                  detalle={`Fuera de Contexto · ${fueraDeContexto?.episodios ?? 0} episodios`}
                />
              </div>

              <p class="mt-3">
                <a
                  href="/podcast"
                  class="group text-[0.8125rem] font-semibold text-navy no-underline">
                  O escuchá el archivo completo acá
                  <span
                    class="inline-block transition-transform duration-150 group-hover:translate-x-1"
                    aria-hidden="true">
                    &nbsp;&rarr;
                  </span>
                </a>
              </p>
            </div>

            {/* Más recientes, en lista compacta */}
            {columnaConAutor.length > 0 && (
              <div>
                <h2 class="rotulo mb-3 border-b border-borde-fuerte pb-2.5">También reciente</h2>
                <ul class="list-none">
                  {columnaConAutor.map(({ nota, autor }) => (
                    <li class="border-b border-borde last:border-0">
                      <a href={`/notas/${nota.id}`} class="group block py-3.5 no-underline">
                        <p class="rotulo mb-1.5 text-tinta-3">
                          {nota.data.categorias[0]}
                        </p>
                        <h3 class="mb-1.5 text-[0.9375rem] leading-[1.35] font-semibold text-tinta group-hover:underline group-hover:decoration-navy group-hover:underline-offset-[3px]">
                          {nota.data.titulo}
                        </h3>
                        <p class="meta-linea">
                          {autor?.data.nombre}
                          <span aria-hidden="true"> · </span>
                          <time datetime={fechaISO(nota.data.fecha)}>
                            {fechaLarga(nota.data.fecha)}
                          </time>
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </section>
    )
  }

  {/* ---------- Últimas notas: la grilla ---------- */}
  {
    enGrilla.length > 0 && (
      <section class="contenedor pb-12" aria-labelledby="titulo-ultimas">
        <div class="barra-seccion">
          <h2 id="titulo-ultimas" class="rotulo">Últimas notas</h2>
          <a
            href="/notas"
            class="group text-[0.6875rem] font-extrabold tracking-[0.12em] text-navy uppercase no-underline">
            Ver todas
            <span
              class="inline-block transition-transform duration-150 group-hover:translate-x-1"
              aria-hidden="true">
              &nbsp;&rarr;
            </span>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-3 pt-8 sm:grid-cols-2 lg:grid-cols-4">
          {enGrilla.map((nota) => <NotaCard nota={nota} />)}
        </div>
      </section>
    )
  }

  {
    todas.length === 0 && (
      <section class="contenedor py-20">
        <p class="max-w-[52ch] text-tinta-2">
          Todavía no hay notas publicadas. Agregá un archivo <code
            class="bg-fondo-2 px-1.5 py-0.5 text-[0.9em]">.md</code
          > en <code class="bg-fondo-2 px-1.5 py-0.5 text-[0.9em]">src/content/notas/</code> y
          aparece acá sola.
        </p>
      </section>
    )
  }
</Base>
